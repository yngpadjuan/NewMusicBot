[DEFAULT]
token =                    # Discord bot token
logLevel = INFO            # DEBUG | INFO | WARN | ERROR
alertChannelId =           # Discord channel ID for ops/error alerts
publishChannelId =         # Discord channel ID for public song announcements
artist =                   # MP3 ID3 artist tag
album =                    # MP3 ID3 album tag
mountPoint =               # Folder to watch for new wav files (non-Linux / no SD card)
watchdog_location =        # Folder to watch for dropped .wav files (runs alongside udev on Linux)
srcFolder =
destFolder =
backupFolder =
ftpFolder =
refFile =

[basement]
sessionName = Basement Bar
subFolder = /STEREO/FOLDER01  # Path to source folder on mountPoint
destFolder =                  # Path to destination folder on local machine
backupFolder =                # Path to backup folder on local machine
ftpFolder =                   # Path to destination folder on FTP server
refFile =                     # Path to mastering reference file

[gigs]
sessionName = Conifock
subFolder = /STEREO/FOLDER01 
destFolder =
backupFolder =
ftpFolder =
refFile =
